<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE spechtml PUBLIC "-//DVT//specador-preferences" "specador-preferences.dtd">
<spechtml version="7">
    <!-- Location where documentation will be generated. Relative paths are solved as relative to project directory. -->
    <location>$HOME/dvt_predefined_projects_target/uvm_ref_flow_1.1</location>
    <!-- Syntax for comments formatting: reStructuredText, markdown, javadoc, naturaldocs, auto or noformat. -->
    <doc-formatting-type>markdown</doc-formatting-type>
    <!-- Generate UML inheritance diagram for each class. -->
    <export-uml-inheritance-diagram>true</export-uml-inheritance-diagram>
    <!-- Generate UVM Component diagrams for each test. -->
    <export-uvm-test-diagram>true</export-uvm-test-diagram>
    <!-- Generate UML collaboration diagram for each class, struct, or unit. -->
    <export-uml-collaboration-diagram>true</export-uml-collaboration-diagram>
    <!-- Generate design block diagram for each module, entity. -->
    <export-design-block-diagram>true</export-design-block-diagram>
    <!-- Generate design flow diagram for each module, entity. -->
    <export-design-flow-diagram>true</export-design-flow-diagram>
    <!-- Generate design schematic diagram for each module, entity. -->
    <export-design-schematic-diagram>true</export-design-schematic-diagram>
    <!-- Generate finite-state machine diagrams for all state variables found in the module, entity. -->
    <export-fsm-diagrams>true</export-fsm-diagrams>
    <!-- Show default state in FSM Diagrams -->
    <fsm-show-default-state>false</fsm-show-default-state>
    <!-- Generate bitfield diagram for each UVM register. -->
    <export-bitfield-diagram>true</export-bitfield-diagram>
    <!-- Include design parameters in the instances and submodules hierarchies. -->
    <include-design-parameters>false</include-design-parameters>
    <export-vlog-libraries>
        <export-vlog-library name="work">
            <export-vlog-modules>true</export-vlog-modules>
            <export-vlog-interfaces>true</export-vlog-interfaces>
            <export-vlog-packages>
                <export-vlog-package>ahb_pkg</export-vlog-package>
                <export-vlog-package>apb_pkg</export-vlog-package>
                <export-vlog-package>apb_subsystem_pkg</export-vlog-package>
                <export-vlog-package>gpio_pkg</export-vlog-package>
                <export-vlog-package>spi_pkg</export-vlog-package>
                <export-vlog-package>uart_ctrl_pkg</export-vlog-package>
                <export-vlog-package>uart_pkg</export-vlog-package>
            </export-vlog-packages>
        </export-vlog-library>
    </export-vlog-libraries>
    <export-vhdl-libraries>false</export-vhdl-libraries>
    <export-e-packages>false</export-e-packages>
</spechtml>
